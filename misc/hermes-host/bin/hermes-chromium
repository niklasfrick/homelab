#!/bin/sh
# Resolve the newest Playwright Chromium build and exec it.
# Hermes' browser harness requires an already-running Chromium-family browser
# listening on a DevTools port for a profile dir it scans (~/.config/chromium).
set -e
CHROME=$(ls -d /home/niklas/.cache/ms-playwright/chromium-*/chrome-linux/chrome 2>/dev/null | sort -V | tail -1)
if [ -z "$CHROME" ] || [ ! -x "$CHROME" ]; then
  echo "hermes-chromium: no Playwright Chromium found under ~/.cache/ms-playwright" >&2
  exit 1
fi
exec "$CHROME" "$@"
